# === Core ===
DAILY_CLIP_TARGET=10
MIN_CLIP_SCORE=7
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=60
MAX_CLIPS_PER_SOURCE=5

# === Groq ===
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CHUNK_SIZE=5000
GROQ_OVERLAP=500

# === Whisper ===
WHISPER_MODEL=medium
WHISPAR_DEVICE=cpu

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/oggamingclips
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# === Storage ===
STORAGE_PROVIDER=local          # local | s3 | gcs
STORAGE_BASE_PATH=/data/clips
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=oggamingclips

# === Worker ===
WORKER_POLL_INTERVAL=30         # seconds between checking for new sources
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF=2          # exponential backoff multiplier
WORKER_MAX_CONCURRENT=2
HEALTH_CHECK_PORT=8000

# === Input Sources ===
SOURCES_FOLDER=/data/sources
SOURCE_URLS_FILE=/data/source_urls.txt

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
